# =========================================================
# ncc-core-erp-backend - local environment file
# =========================================================
# Copy this file to `.env` (same folder as pom.xml) and fill in real values.
# application.properties imports it via `spring.config.import=optional:file:.env`.
# NEVER commit `.env` or any file containing real credentials; it is gitignored.

# Active Spring profile: "dev" locally, "prod" on Render.
SPRING_PROFILES_ACTIVE=dev

# Server port. Render injects PORT automatically; 8080 is the local default.
PORT=8080

# Local development database.
# In production these are real environment variables (Render dashboard), not .env.
DB_URL=jdbc:mysql://localhost:3306/ncc_core_erp?useInformationSchema=false
DB_USERNAME=root
DB_PASSWORD=

# Hibernate schema handling. Use "update" for local dev only.
# In production leave this unset so application-prod.properties applies "validate".
# JPA_DDL_AUTO=update
